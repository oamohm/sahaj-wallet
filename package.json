{
  "name": "sahaj-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-Network Web3 Wallet & Rewards Platform - Arc Network + Circle App Kit + USDC, extensible to any EVM chain.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @sahaj/database prisma:generate",
    "db:migrate": "pnpm --filter @sahaj/database prisma:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "@types/node": "^22.7.5"
  },
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
