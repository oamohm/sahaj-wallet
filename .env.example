# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# ---- Database ----
DATABASE_URL=postgresql://sahaj:sahaj@localhost:5432/sahaj_wallet

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Default network ----
DEFAULT_NETWORK=arc

# ---- Arc Network ----
# Arc is still testnet-only as of this writing. USDC is Arc's native gas
# token at 18 decimals, but Arc's own docs recommend apps use its ERC-20
# interface (0x3600...0000, 6 decimals) for balances/transfers instead --
# see https://docs.arc.io/arc/references/contract-addresses.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ---- Ethereum ----
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ETHEREUM_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# ---- Base ----
BASE_RPC_URL=https://mainnet.base.org
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ---- Polygon ----
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ---- Arbitrum ----
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ---- Optimism ----
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_USDC_ADDRESS=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85

# ---- Giwa (optional, enabled by default per the multi-network spec) ----
GIWA_ENABLED=true
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_USDC_ADDRESS=0x0000000000000000000000000000000000dEaD

# ---- Faucet (optional; falls back to manual faucet links if unset) ----
# Set these ONLY if you have a real server-callable JSON faucet API for
# that testnet (POST {"address": "0x..."} -> 2xx on success). Most public
# faucets require a captcha and have no such API, in which case leave
# these unset and the app will hand the user the official faucet link.
# Circle DOES expose a real programmatic faucet API behind a Circle API
# key (20 USDC per address per blockchain every 2 hours) -- see
# https://developers.circle.com/w3s/developer-console-faucet. If you have
# a Circle API key, that endpoint is the honest choice for ARC_FAUCET_API_URL.
ARC_FAUCET_URL=https://faucet.circle.com
ARC_FAUCET_API_URL=
GIWA_FAUCET_URL=https://faucet.giwa.io
GIWA_FAUCET_API_URL=

# ---- Circle App Kit ----
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
CIRCLE_ENVIRONMENT=sandbox
# Circle-managed wallet ID that funds reward claim payouts. Leave unset in
# local/dev to have claims stay "pending" for manual processing.
TREASURY_CIRCLE_WALLET_ID=

# ---- Branding ----
ACTIVE_BRAND=sahaj
